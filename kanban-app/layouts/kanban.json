{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": { "mod": "workspace-chrome" },
          "size": { "px": 46 },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": { "mod": "spaces" },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": { "mod": "workspace-chrome", "props": { "footer": true } },
          "size": { "px": 69 }
        }
      ],
      "size": { "px": 240 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "bar",
          "type": "block",
          "content": { "mod": "kanban", "props": { "part": "bar" } },
          "size": { "px": 52 },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 12,
          "gap": 12,
          "children": [
            {
              "id": "view",
              "type": "stack",
              "active": "board-view",
              "children": [
                {
                  "id": "board-view",
                  "type": "row",
                  "gap": 12,
                  "children": [
                    {
                      "id": "board",
                      "type": "block",
                      "content": { "mod": "kanban", "props": { "part": "board" } },
                      "min": 160
                    },
                    {
                      "id": "detail",
                      "type": "block",
                      "content": { "agent": "focused" },
                      "size": { "px": 460 },
                      "min": 200,
                      "max": 4000,
                      "background": "background",
                      "border": { "width": 1, "color": "border" },
                      "radius": 14,
                      "shadow": "md"
                    }
                  ]
                },
                {
                  "id": "tabs-view",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": { "mod": "pane" },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": { "width": 1, "color": "border" },
                      "focus": { "width": 1, "color": "accent" },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ],
              "size": { "px": 368 },
              "min": 240,
              "max": 1200,
              "hidden": true
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": { "mod": "workspace-status" },
          "size": { "px": 28 }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/kanban.svg"
}
